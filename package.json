{
  "name": "mixbynam-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --env-file=.env.test.local --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:producer": "playwright test --config=playwright.producer.config.ts",
    "test:measure": "playwright test --config=playwright.measure.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
