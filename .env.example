# Somente a chave pública publishable/anon. Nunca usar service_role no site.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA
# Número internacional, apenas dígitos. Ex.: código do país + DDD + número.
NEXT_PUBLIC_PRODUCER_WHATSAPP=SEU-NUMERO-INTERNACIONAL
NEXT_PUBLIC_PRODUCER_NAME=NOME-DO-PRODUTOR
# Testes reais em projeto Supabase separado; não preencher para produção.
TEST_PRODUCER_EMAIL=EMAIL-DO-PRODUTOR-DE-TESTE
TEST_PRODUCER_PASSWORD=SENHA-DO-PRODUTOR-DE-TESTE
TEST_OTHER_EMAIL=EMAIL-DE-USUARIO-NAO-AUTORIZADO
TEST_OTHER_PASSWORD=SENHA-DE-USUARIO-NAO-AUTORIZADO
TEST_CONFIRM_ISOLATED_PROJECT=NAO-HABILITAR-EM-PRODUCAO
